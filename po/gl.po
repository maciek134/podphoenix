msgstr "Atrás"

#: ../app/ui/EpisodesPage.qml:131
msgid "Search episode"
msgstr "Buscar episodio"

#: ../app/ui/EpisodesPage.qml:150
msgid "Unsubscribe Confirmation"
msgstr "Confirmar a cancelación"

#: ../app/ui/EpisodesPage.qml:151
#, qt-format
msgid "Are you sure you want to unsubscribe from <b>%1</b>?"
msgstr "Confirma a cancelación da subscrición a  <b>%1</b>?"

#: ../app/ui/EpisodesPage.qml:170
msgid "Cancel"
msgstr "Cancelar"

#: ../app/ui/EpisodesPage.qml:184
msgid "No Episodes found"
msgstr "Non se atoparon episodios"

#: ../app/ui/EpisodesPage.qml:185
msgid "No episodes found matching the search term."
msgstr "Non hai episodios con ese termo de busca."

#: ../app/ui/EpisodesPage.qml:319
#, no-c-format, qt-format
msgid "%1h %2m"
msgstr "%1h %2m"

#: ../app/ui/EpisodesPage.qml:328
#, no-c-format, qt-format
msgid "%1h"
msgstr "%1h"

#: ../app/ui/EpisodesPage.qml:336
#, no-c-format, qt-format
