msgid "-15s"
msgstr "-15s"

#: ../app/ui/NowPlayingPage.qml:204
msgid "+15s"
msgstr "+15s"

#: ../app/ui/PodcastsTab.qml:32
msgid "Podcasts"
msgstr "Podcasts"

#: ../app/ui/PodcastsTab.qml:62
msgid "Add Podcast"
msgstr "Engadir podcast"

#: ../app/ui/PodcastsTab.qml:72
msgid "Search Podcast"
msgstr "Buscar podcast"

#: ../app/ui/PodcastsTab.qml:97
msgid "Search podcast"
msgstr "Buscar podcast"

#: ../app/ui/PodcastsTab.qml:120
msgid "Save Podcast"
msgstr "Gardar podcast"

#: ../app/ui/PodcastsTab.qml:133
msgid "Feed URL"
msgstr "URL da fonte"

#: ../app/ui/PodcastsTab.qml:157
msgid "Unable to subscribe"
msgstr "Non foi posíbel subscribirse"

#: ../app/ui/PodcastsTab.qml:158
msgid "Please check the URL and try again"
msgstr "Comprobe a URL e ténteo de novo"

#: ../app/ui/PodcastsTab.qml:160
msgid "Close"
msgstr "Pechar"

#: ../app/ui/PodcastsTab.qml:172
msgid "No Podcast Subscriptions"
msgstr "Non hai subscricións ao podcast"

#: ../app/ui/PodcastsTab.qml:173
msgid "No Podcasts Found"
msgstr "Non se atoparon podcasts"

#: ../app/ui/PodcastsTab.qml:174
msgid ""
"You haven't subscribed to any podcasts yet, visit the 'Find New Podcasts' "
"page to add some."
msgstr ""
"Non se subscribiu a ningún podcast, visite a páxina «Buscar novos podcasts» "
"para engadir algún."

#: ../app/ui/PodcastsTab.qml:175
msgid "No podcasts found matching the search term."
msgstr "Non hai podcasts con ese termo de busca."

#: ../app/ui/PodcastsTab.qml:291
#, qt-format
msgid "%1 unheard episode"
msgid_plural "%1 unheard episodes"
msgstr[0] "%1 episodio sen escoitar"
msgstr[1] "%1 episodios sen escoitar"

#: ../app/ui/SearchTab.qml:27
msgid "Find New Podcasts"
msgstr "Novos podcasts"

#: ../app/ui/SearchTab.qml:42
msgid "Search..."
msgstr "Buscar…"

#: ../app/ui/SearchTab.qml:122
msgid "Subscribe"
msgstr "Subscribir"

#: ../app/ui/SettingsPage.qml:32
msgid "General Settings"
msgstr "Axustes xerais"

#: ../app/ui/SettingsPage.qml:44
msgid "Podcast Episode Settings"
msgstr "Axustes dos episodios dos podcasts"

#: ../app/ui/SettingsPage.qml:59
msgid "Automatically delete old episodes"
msgstr "Eliminar episodios vellos automaticamente"

#: ../app/ui/SettingsPage.qml:67
msgid ""
"Delete episodes that are older than a given number of days for each podcast"
msgstr ""
"Eliminar episodios máis vellos que un número dado de días para cada podcast"

#: ../app/ui/SettingsPage.qml:84
msgid "Automatically download new episodes"
msgstr "Descargar novos episodios automaticamente"

#: ../app/ui/SettingsPage.qml:92
msgid "Default number of new episodes to download for each podcast"
msgstr "Número predeterminado de episodios a descargar por podcast"

#: ../app/ui/Walkthrough.qml:87
msgid "Skip"
msgstr "Saltar"

#: ../app/welcomewizard/Slide1.qml:42
msgid "Welcome to Podbird"
msgstr "Benvido/a ao Podbird"

#: ../app/welcomewizard/Slide1.qml:50
msgid ""
"Enjoy your favourite shows with Podbird, the chirpiest podcast manager for "
"Ubuntu.\n"
"\n"
"Chirp Chirp..."
msgstr ""
"Goce dos seus programas favoritos co Podbird, o xestor de podcasts máis "
"rechouchiante de Ubuntu.\n"
"\n"
"Pío pío..."

#: ../app/welcomewizard/Slide1.qml:72
msgid "Swipe to move between pages"
msgstr "Esvare o dedo para cambiar de páxina"

#: ../app/welcomewizard/Slide2.qml:45
msgid "Discover New Podcasts"
msgstr "Descubrir novos podcasts"

#: ../app/welcomewizard/Slide2.qml:62
msgid ""
"Podbird uses the iTunes® database to provide access to a huge collection of "
"podcasts. You can also add podcasts by their URL."
msgstr ""
"O Podbird usa a base de datos de iTunes® para permitirlle o acceso a unha "
"gran colección de podcasts. Tamén pode engadir un podcast mediante unha URL."

#: ../app/welcomewizard/Slide3.qml:45
msgid "Smart Settings"
msgstr "Axustes intelixentes"

#: ../app/welcomewizard/Slide3.qml:62
msgid ""
"Podbird can optionally download new episodes and clean up old episodes "
"automatically, this can be enabled from the settings page."
msgstr ""
"O Podbird tamén pode descargar novos episodios e eliminar os vellos "
"automaticamente. Esta opción actívase nos axustes."

#. TRANSLATORS: This text should be in a language different from the language set by the user.
#. For instance, if the app was in english, then it is appropriate to set this string as
#. Hallo or Bonjour etc to symbolize the internationalization feature in podbird.
#: ../app/welcomewizard/Slide4.qml:48
msgid "Hallo! Bonjour!"
msgstr "Hallo! Bonjour!"

#: ../app/welcomewizard/Slide4.qml:66
#, qt-format
msgid ""
"Podbird is available in over 15 languages and is translated by the %1 "
"community"
msgstr ""
"O Podbird está dispoñíbel en máis de 15 idiomas e é traducido pola "
"comunidade %1"

#: ../app/welcomewizard/Slide5.qml:45
msgid "Support"
msgstr "Asistencia"

#. TRANSLATORS: The %1 points to a url defined in html format <a href=\link\>Link</a>.
#: ../app/welcomewizard/Slide5.qml:64
#, qt-format
msgid ""
"If you find any bugs or have any feature requests, let us know on our "
"project page at %1"
msgstr ""
"Se descubre un erro ou desexa unha funcionalidade, fáganolo saber na nosa "
"páxina web en %1"

#: ../app/welcomewizard/Slide6.qml:45
msgid "Enjoy"
msgstr "Goce"

#: ../app/welcomewizard/Slide6.qml:62
msgid "We hope you enjoy using Podbird!"
msgstr "Esperamos que goce co Podbird."

#: ../app/welcomewizard/Slide6.qml:76
msgid "Finish"
msgstr "Rematar"

