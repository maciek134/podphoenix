#: ../app/ui/EpisodesPage.qml:85
msgid "Search Episode"
msgstr "Buscar epìsodio"

#: ../app/ui/EpisodesPage.qml:94
msgid "Mark all listened"
msgstr "Marcar todo como escoitado"

#: ../app/ui/EpisodesPage.qml:105 ../app/ui/EpisodesPage.qml:153
